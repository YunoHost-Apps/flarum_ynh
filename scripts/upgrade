#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# LOAD SETTINGS
#=================================================
ynh_script_progression "Loading installation settings..."

old_core_version=$(ynh_app_setting_get --app=$app --key=core_version)
core_version=$(ynh_app_upstream_version)

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

# Remove bazaar_extension if it exists
bazaar_extension=$(ynh_app_setting_get --app=$app --key=bazaar_extension)
if [ ! -z "$bazaar_extension" ]; then
    ynh_app_setting_delete --app=$app --key=bazaar_extension
fi

# Remove SSOwat extension if it exists
ssowat_extension=$(ynh_app_setting_get --app=$app --key=ssowat_extension)
if [ ! -z "$ssowat_extension" ]; then
    ynh_hide_warnings ynh_composer_exec remove tituspijean/flarum-ext-auth-ssowat --no-update
    ynh_app_setting_delete --app=$app --key=ssowat_extension
fi

# Remove tituspijean's LDAP extension if it exists
if [ ! -z "${ldap_version:-}" ]; then
    ynh_hide_warnings ynh_composer_exec remove tituspijean/flarum-ext-auth-ldap --no-update
    ynh_app_setting_delete --key=ldap_version
fi

if [ ! -z "${project_version:-}" ]; then
    ynh_app_setting_delete --key=project_version
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================

# Copy assets from old app version. Can be either in root folder or in "public" folder
if [ -d "$install_dir/assets" ]; then
    ynh_setup_source --dest_dir="$install_dir" --source_id="flarum" --keep="config.php assets public"
else
    ynh_setup_source --dest_dir="$install_dir" --source_id="flarum" --keep="config.php public"
fi

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

# Create a dedicated php-fpm config
ynh_config_add_phpfpm

# Create a dedicated NGINX config
ynh_config_add_nginx

# Use logrotate to manage app-specific logfile(s)
ynh_config_add_logrotate

#=================================================
# CONFIGURE DEX APP FOR OAUTH2 / OIDC
#=================================================
ynh_script_progression "Configuring dex..."

setup_dex

#=================================================
# ADD SWAP
#=================================================
ynh_script_progression "Adding swap..."

if [ ${PACKAGE_CHECK_EXEC:-0} -eq 0 ]; then
    ynh_add_swap --size=$swap_needed
fi

#=================================================
# COMPOSER AND FLARUM UPGRADE
#=================================================
ynh_script_progression "Installing composer dependencies..."

# Set right permissions
chown -R $app:www-data $install_dir

if ynh_app_upgrading_from_version_before 1.1.0~ynh1
then
    # Starting 1.0 (implemented for 1.1 in the package), version requirement is "*" for extensions
    # ... except for flarum/core, but that's handled in the next block.
    jq '.require | .[] = "*"' $install_dir/composer.json
fi

pushd $install_dir

    # Disable policy advisories for 1.8.x
    # This is suggested by upstream documentation: https://docs.flarum.org/update/#before-you-begin
    ynh_hide_warnings ynh_composer_exec config --json "policy.advisories.ignore-id" '["PKSA-w9tt-7782-78jx", "PKSA-pwh8-d4fr-nywn"]'

    # Remove and migrate extensions for v2.x
    if ynh_app_upgrading_from_version_before 2.0.0~ynh1
    then
        ynh_hide_warnings ynh_composer_exec remove blomstra/database-queue blomstra/fontawesome --no-update
        ynh_replace --match="blomstra/flarum-redis" --replace="fof/redis" --file=composer.json
        ynh_replace --match="blomstra/horizon" --replace="fof/horizon" --file=composer.json
        ynh_replace --match="flarum/package-manager" --replace="flarum/extension-manager" --file=composer.json
    fi

    ynh_script_progression "Upgrading Flarum and its extensions..."
    ynh_hide_warnings ynh_composer_exec require "flarum/core:$core_version" "floxum/flarum-ext-oidc:*" "flarum/extension-manager:*" --no-update
    ynh_hide_warnings ynh_composer_exec update --prefer-dist --no-plugins --no-dev -a --with-all-dependencies
    ynh_exec_as_app php$php_version flarum migrate
    ynh_exec_as_app php$php_version flarum cache:clear

popd

ynh_app_setting_set --key=core_version --value="$core_version"

#=================================================
# FLARUM EXTENSIONS
#=================================================

if ! ynh_exec_as_app php$php_version $install_dir/flarum info | grep -q "floxum-oidc";
then
    # Install and activate the LDAP auth extension
    activate_flarum_extension -d $db_name -s "floxum-oidc"
    # Configure LDAP auth extension
    ynh_config_add --template="../conf/oidc.sql.template" --destination="../conf/oidc.sql"
    ynh_mysql_db_shell $db_name < ../conf/oidc.sql
fi

# Install, activate and set language extensions
case $language in
    fr)
    ynh_script_progression "Installing French extension..."
    ynh_hide_warnings ynh_composer_exec require flarum-lang/french:*
    activate_flarum_extension -d $db_name -s "flarum-lang/french"
    sql_command="UPDATE \`settings\` SET \`value\` = 'fr' WHERE \`settings\`.\`key\` = 'default_locale'"
    ynh_mysql_db_shell $db_name <<< "$sql_command;"
    ;;
    de)
    ynh_script_progression "Installing German extension..."
    ynh_hide_warnings ynh_composer_exec require flarum-lang/german:*
    activate_flarum_extension -d $db_name -s "flarum-lang/german"
    sql_command="UPDATE \`settings\` SET \`value\` = 'de' WHERE \`settings\`.\`key\` = 'default_locale'"
    ynh_mysql_db_shell $db_name <<< "$sql_command;"
    ;;
esac

# Remove deprecated translation plugins
ynh_hide_warnings ynh_composer_exec remove qiaeru/lang-french:*
ynh_hide_warnings ynh_composer_exec remove kakifrucht/flarum-de:*

ynh_print_info "You may need to manually enable your language extension in Flarum's admin panel."

# Set files and directories permissions
chmod 750 "$install_dir"
chmod -R o-rwx "$install_dir"
chown -R $app:www-data "$install_dir"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
